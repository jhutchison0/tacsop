# Environment Variables Template
# Copy to .env and fill in actual values
# NEVER commit .env to git!

# Slack Integration (optional — for src/myproject/utils/slack.py)
SLACK_BOT_TOKEN=xoxb-your-token-here

# Database (optional — for src/myproject/utils/database.py)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mydb
DB_USER=postgres
DB_PASSWORD=your_password_here

# Home storage roots (personal projects only — see
# .claude/skills/lake-conventions/HOME-STORAGE.md). Real network paths go
# here in .env and nowhere committed; names stay role-based, never host-based.
HOME_MEDIA_ROOT=\\<nas-host>\<media-share>
HOME_CORPUS_ROOT=\\<nas-host>\<well-share>\corpus

COLORTERM=truecolor
