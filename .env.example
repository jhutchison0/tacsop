# Environment Variables Template
# Copy to .env and fill in actual values
# NEVER commit .env to git!

# Slack Integration (optional — for src/myproject/utils/slack.py)
SLACK_BOT_TOKEN=xoxb-your-token-here

# Database (optional — for src/myproject/utils/database.py)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mydb
DB_USER=postgres
DB_PASSWORD=your_password_here
